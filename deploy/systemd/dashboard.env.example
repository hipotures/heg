# Use absolute paths. Quote a value if it contains spaces.
SGLAB_DASHBOARD_REPOSITORY=/srv/heg
SGLAB_DASHBOARD_WORKSPACE=/srv/heg/workspace/experiment-01
SGLAB_DASHBOARD_HOST=127.0.0.1
SGLAB_DASHBOARD_PORT=8788
SGLAB_DASHBOARD_PYTHON=/srv/heg/.venv/bin/python

# Keep the token itself out of this file and out of the repository.
SGLAB_DASHBOARD_TOKEN_FILE=/home/user/.config/sglab/dashboard.token

# Optional source used only by explicitly authorized AI campaign operations.
# SGLAB_CODEX_AUTH_SOURCE=/home/user/.codex/auth.json
